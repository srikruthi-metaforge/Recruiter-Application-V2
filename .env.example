# Copy to .env and fill values. Never commit secrets.

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_URL=http://localhost:3001

# --- Backend ---
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/metaforge_recruiter_v2
MONGODB_DB_NAME=metaforge_recruiter_v2
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000
STORAGE_ROOT=./backend/storage
SEED_ON_START=true
RATE_LIMIT_PER_MINUTE=120

# --- AI Gateway ---
AI_GATEWAY_URL=http://localhost:3002
AI_GATEWAY_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional integrations (leave empty until approved) ---
PDL_API_KEY=
NAUKRI_API_KEY=
RESEND_API_KEY=
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
