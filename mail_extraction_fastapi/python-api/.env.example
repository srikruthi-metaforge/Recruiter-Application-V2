# FastAPI mail-extraction gateway (does not replace Nest)
PORT=8000
# Shared secret Nest sends as X-API-Key (optional but recommended)
PYTHON_API_KEY=

# Where scripts/sync_to_backend.py + .venv live (optional; auto-detected as sibling Mail extraction/)
# Example: ../Mail extraction/devloper/devloper  (relative to this python-api folder)
MAIL_EXTRACTION_DIR=
MAIL_EXTRACTION_PYTHON=

# Nest URL the pipeline posts ingest-email to (same as today)
METAFORGE_API_URL=http://127.0.0.1:3001
METAFORGE_REQUIREMENTS_ENDPOINT=api/v1/requirements/ingest-email
# Same key Nest uses for INTERNAL_AUTOMATION_API_KEY
METAFORGE_API_KEY=

# Default timeout for one sync run (minutes)
MAIL_EXTRACTION_TIMEOUT_MINUTES=20
