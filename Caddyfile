{
	auto_https off
}

:80 {
  encode gzip

  handle /api/* {
    reverse_proxy backend:3001
  }

  handle /health {
    reverse_proxy backend:3001
  }

  handle {
    reverse_proxy frontend:3000
  }

  header {
    -Strict-Transport-Security
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
